<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="decimals">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="decimal" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:attribute name="value" type="xs:float" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
